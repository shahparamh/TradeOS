# ========================================
# TradeOS — Environment Configuration Template
# ========================================

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key
XAI_API_KEY=your_xai_key
GROQ_API_KEY=your_groq_api_key

# --- News APIs ---
NEWS_API_KEY=your_news_api_key

# --- Database ---
DATABASE_URL=sqlite:///./tradeos.db

# --- Trading Config ---
INITIAL_CAPITAL=100000
MAX_CAPITAL_PER_TRADE=0.20
MAX_OPEN_POSITIONS=5
MAX_INTRADAY_TRADES=3
AUTO_SQUARE_OFF_TIME=15:15
DAILY_DRAWDOWN_LIMIT=-0.05

# --- Broker Simulation ---
BROKERAGE_PERCENT=0.0003
SLIPPAGE_PERCENT=0.0005

# --- Scheduler ---
SCAN_INTERVAL_MINUTES=10

# --- Alpaca (US Market Data / Paper Trading) ---
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
